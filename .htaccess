# php handler (keep this part unchanged)
# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit


Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    ########################################
    ### 1. Redirect ROOT ONLY to /public ###
    ########################################
    RewriteCond %{REQUEST_URI} ^/$
    RewriteRule ^$ public/ [R=302,L]


    ########################################
    ### 2. Storage is accessible directly ###
    ########################################
    RewriteRule ^storage/(.*)$ storage/$1 [L,QSA]


    ########################################
    ### 3. Admin and User paths ###
    ########################################
    RewriteRule ^admin/?(.*)$ public/admin/$1 [L,QSA]
    RewriteRule ^user/?(.*)$ public/user/$1 [L,QSA]


    ###########################################
    ### 4. Redirect EVERYTHING ELSE to public #
    ###########################################
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_URI} !^/storage/
    RewriteCond %{REQUEST_URI} !^/admin
    RewriteCond %{REQUEST_URI} !^/user
    RewriteRule ^(.*)$ public/$1 [L,QSA]

</IfModule>


########################################################
### Block sensitive folders outside public ###########
########################################################
RedirectMatch 403 ^/(app|bootstrap|config|database|resources|routes|tests|vendor)(.*)$
